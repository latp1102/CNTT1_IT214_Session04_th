{
  "info": {
    "name": "MediCare Microservices API",
    "description": "Postman Collection for testing MediCare Microservices - Bài Tập 5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "patient_base_url",
      "value": "http://localhost:8081/api/patients"
    },
    {
      "key": "doctor_base_url",
      "value": "http://localhost:8082/api/doctors"
    },
    {
      "key": "appointment_base_url",
      "value": "http://localhost:8083/api/appointments"
    },
    "medical_record_base_url": "http://localhost:8084/api/medical-records"
  ],
  "item": [
    {
      "name": "Patient Service",
      "item": [
        {
          "name": "Create Patient 1",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguyễn Văn An\",\n  \"phone\": \"0901234567\",\n  \"email\": \"an.nguyen@email.com\",\n  \"address\": \"Hà Nội\",\n  \"dateOfBirth\": \"1990-01-15\"\n}"
            },
            "url": "{{patient_base_url}}"
          }
        },
        {
          "name": "Create Patient 2",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Trần Thị Bình\",\n  \"phone\": \"0902345678\",\n  \"email\": \"binh.tran@email.com\",\n  \"address\": \"TP.HCM\",\n  \"dateOfBirth\": \"1985-05-20\"\n}"
            },
            "url": "{{patient_base_url}}"
          }
        },
        {
          "name": "Create Patient 3",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lê Văn Cường\",\n  \"phone\": \"0903456789\",\n  \"email\": \"cuong.le@email.com\",\n  \"address\": \"Đà Nẵng\",\n  \"dateOfBirth\": \"1992-11-30\"\n}"
            },
            "url": "{{patient_base_url}}"
          }
        },
        {
          "name": "Get All Patients",
          "request": {
            "method": "GET",
            "url": "{{patient_base_url}}"
          }
        },
        {
          "name": "Get Patient by ID",
          "request": {
            "method": "GET",
            "url": "{{patient_base_url}}/1"
          }
        }
      ]
    },
    {
      "name": "Doctor Service",
      "item": [
        {
          "name": "Create Doctor 1",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"BS. Nguyễn Minh Đức\",\n  \"specialty\": \"Tim mạch\",\n  \"phone\": \"0911111111\",\n  \"email\": \"duc.nguyen@medicare.vn\",\n  \"licenseNumber\": \"MD001\"\n}"
            },
            "url": "{{doctor_base_url}}"
          }
        },
        {
          "name": "Create Doctor 2",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"BS. Phạm Thị Hương\",\n  \"specialty\": \"Nhi khoa\",\n  \"phone\": \"0922222222\",\n  \"email\": \"huong.pham@medicare.vn\",\n  \"licenseNumber\": \"MD002\"\n}"
            },
            "url": "{{doctor_base_url}}"
          }
        },
        {
          "name": "Get All Doctors",
          "request": {
            "method": "GET",
            "url": "{{doctor_base_url}}"
          }
        },
        {
          "name": "Get Doctor by ID",
          "request": {
            "method": "GET",
            "url": "{{doctor_base_url}}/1"
          }
        }
      ]
    },
    {
      "name": "Appointment Service",
      "item": [
        {
          "name": "Create Appointment (Success)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 1,\n  \"doctorId\": 1,\n  \"appointmentDate\": \"2026-09-15T10:00:00\",\n  \"status\": \"PENDING\",\n  \"notes\": \"Khám tim mạch định kỳ\"\n}"
            },
            "url": "{{appointment_base_url}}"
          }
        },
        {
          "name": "Create Appointment - Patient Not Found (Error)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 999,\n  \"doctorId\": 1,\n  \"appointmentDate\": \"2026-09-15T10:00:00\",\n  \"status\": \"PENDING\"\n}"
            },
            "url": "{{appointment_base_url}}"
          }
        },
        {
          "name": "Create Appointment - Doctor Not Found (Error)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 1,\n  \"doctorId\": 999,\n  \"appointmentDate\": \"2026-09-15T10:00:00\",\n  \"status\": \"PENDING\"\n}"
            },
            "url": "{{appointment_base_url}}"
          }
        },
        {
          "name": "Get All Appointments",
          "request": {
            "method": "GET",
            "url": "{{appointment_base_url}}"
          }
        },
        {
          "name": "Get Appointment by ID",
          "request": {
            "method": "GET",
            "url": "{{appointment_base_url}}/1"
          }
        },
        {
          "name": "Get Appointment Detail (with Patient & Doctor)",
          "request": {
            "method": "GET",
            "url": "{{appointment_base_url}}/1/detail"
          }
        },
        {
          "name": "Update Appointment to COMPLETED",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 1,\n  \"doctorId\": 1,\n  \"appointmentDate\": \"2026-09-15T10:00:00\",\n  \"status\": \"COMPLETED\",\n  \"notes\": \"Khám tim mạch định kỳ - đã xong\"\n}"
            },
            "url": "{{appointment_base_url}}/1"
          }
        }
      ]
    },
    {
      "name": "Medical Record Service",
      "item": [
        {
          "name": "Create Medical Record (Success - Appointment COMPLETED)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": 1,\n  \"patientId\": 1,\n  \"doctorId\": 1,\n  \"diagnosis\": \"Rối loạn nhịp tim nhẹ\",\n  \"treatment\": \"Theo dõi, uống thuốc điều hòa nhịp tim\",\n  \"prescription\": \"Bisohexal 2.5mg x 1 viên/ngày\",\n  \"notes\": \"Tái khám sau 1 tháng\"\n}"
            },
            "url": "{{medical_record_base_url}}"
          }
        },
        {
          "name": "Create Medical Record - Appointment Not COMPLETED (Error)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": 2,\n  \"patientId\": 2,\n  \"doctorId\": 2,\n  \"diagnosis\": \"Test\",\n  \"treatment\": \"Test\",\n  \"prescription\": \"Test\"\n}"
            },
            "url": "{{medical_record_base_url}}"
          }
        },
        {
          "name": "Create Medical Record - Appointment Not Found (Error)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": 999,\n  \"patientId\": 1,\n  \"doctorId\": 1,\n  \"diagnosis\": \"Test\"\n}"
            },
            "url": "{{medical_record_base_url}}"
          }
        },
        {
          "name": "Get All Medical Records",
          "request": {
            "method": "GET",
            "url": "{{medical_record_base_url}}"
          }
        },
        {
          "name": "Get Medical Record by Appointment ID",
          "request": {
            "method": "GET",
            "url": "{{medical_record_base_url}}/appointment/1"
          }
        }
      ]
    }
  ]
}